# Resend API key for sending emails
# Get it from: https://resend.com/api-keys
RESEND_API_KEY=re_xxx

# Email address to send from (must be verified in Resend)
# For testing, use: onboarding@resend.dev
# For production, use your domain: orders@yourdomain.com
FROM_EMAIL=onboarding@resend.dev

# Reply-To email address (optional)
# Customers will reply to this address
# For production, use: support@yourdomain.com
REPLY_TO_EMAIL=support@yourdomain.com

# Admin email to receive order notifications
ADMIN_EMAIL=admin@yourdomain.com
